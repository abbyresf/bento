# Environment variables — never commit secrets
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.playwright-mcp
.vercel

# Intermediate output of the build-time prerender (scripts/prerender.mjs).
# Removed on a successful build; left behind if one fails partway.
.ssr-build

# ── iOS / Xcode ──
# The ios/ project itself is committed. It holds real configuration that is not
# regenerable from capacitor.config.ts: entitlements, Info.plist, the app icon
# set, the launch screen, and push capabilities. Running `npx cap add ios` again
# would not reproduce them.
#
# Everything Xcode regenerates stays out. Decided before the directory exists,
# because the alternative is noticing after the first commit.
ios/App/build/
ios/App/Pods/
ios/App/output/
ios/App/App/public/
DerivedData/
*.xcuserstate
**/xcuserdata/
