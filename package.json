{
  "name": "bento",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "rm -rf node_modules/.vite",
    "build": "vite build && npm run build:ssr && node scripts/prerender.mjs && node scripts/check-csp.mjs",
    "build:native": "vite build --mode native && node scripts/check-csp.mjs",
    "ios:sync": "npm run build:native && cap sync ios",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:meals": "node test/mealPlan.test.mjs",
    "build:ssr": "vite build --ssr src/prerender-entry.jsx --outDir .ssr-build --emptyOutDir"
  },
  "dependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@emailjs/browser": "^4.4.1",
    "@supabase/supabase-js": "^2.104.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/edge": "^1.3.3",
    "lucide-react": "^1.34.0",
    "node-html-parser": "^9.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0"
  }
}
